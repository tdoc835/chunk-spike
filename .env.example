# OpenAI Configuration
OPENAI_API_KEY=sk-...                    # Required - Your OpenAI API key

# Qdrant Configuration
QDRANT_URL=http://localhost:6333         # Local: http://localhost:6333, Cloud: https://xyz.qdrant.io
QDRANT_API_KEY=                          # Optional for local, required for Qdrant Cloud
QDRANT_COLLECTION=dev_docs               # Collection name to use

# Processing Configuration
SAMPLES_DIR=./samples                    # Root directory containing documents to process
BATCH_SIZE=50                            # Number of points to upsert at once (default: 50)
EMBEDDING_BATCH_SIZE=100                 # Number of texts to embed per API call (default: 100)
MAX_RETRIES=3                            # Retry attempts for API calls (default: 3)
